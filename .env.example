# Environment Variables Template for Medical Chronology Platform
# Copy this file to .env.local and fill in your actual values

# Application Configuration
NEXT_PUBLIC_APP_NAME="MedChron AI - Medical AI Assistant"
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"

# API Configuration (if you have backend APIs)
# NEXT_PUBLIC_API_URL="https://api.your-domain.com"
# API_SECRET_KEY="your-secret-key-here"

# File Upload Configuration
# NEXT_PUBLIC_MAX_FILE_SIZE="10485760" # 10MB in bytes
# NEXT_PUBLIC_ALLOWED_FILE_TYPES="pdf,doc,docx,png,jpg,jpeg,tiff"

# AI/ML Service Configuration (if using external AI services)
# OPENAI_API_KEY="your-openai-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# Database Configuration (if using a database)
# DATABASE_URL="your-database-connection-string"
# DATABASE_SECRET="your-database-secret"

# Authentication (if using authentication services)
# NEXTAUTH_SECRET="your-nextauth-secret"
# NEXTAUTH_URL="https://your-app-name.vercel.app"

# Third-party Services
# STRIPE_SECRET_KEY="your-stripe-secret-key" # if using payments
# STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"

# Analytics (optional)
# NEXT_PUBLIC_GA_ID="your-google-analytics-id"
# NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-token"

# Email Service (if using email notifications)
# SMTP_HOST="your-smtp-host"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"

# Storage (if using cloud storage for file uploads)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-s3-bucket-name"

# Development/Production Environment
NODE_ENV="production"
